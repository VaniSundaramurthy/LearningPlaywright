//Check if a number is even or odd in JAvascript
let number = 10;
//% Operator uses to get the remainder of a division operation.
//  If the remainder is 0 when dividing by 2, then the number is even; 
//      otherwise, it's odd.
//Tripe equal (===) operator is used to compare both value and type.
//Double equal (==) operator is used to compare only value, it performs type coercion if necessary.
//What is value and type coercion?
//Value coercion is the process of converting a value from one type to another, 
// such as converting a string to a number or a boolean to a string.


if (number % 2 === 0) {
    console.log(number + " is an even number.");
} else {
    console.log(number + " is an odd number.");
}


//Print the grade based on these rules in javascript:
// 90 and above: A
// 80-89: B
// 70-79: C
// 60-69: D
// Below 60: Fail  
let score = 85;
if (score >= 90 && score <= 100) {
    console.log("Grade: A");
} else if (score >= 80 && score < 90) {
    console.log("Grade: B");
}
else if (score >= 70 && score < 80) {
    console.log("Grade: C");
}

else if (score >= 60 && score < 70) {
    console.log("Grade: D");
}
else if (score < 60) {
    console.log("Grade: F");
}
//Problem: Take a year and check if it's a leap year.   
let year = 2020;
if ((year % 4 === 0 && year % 100 !== 0) || (year % 400 === 0)) {
    console.log(year + " is a leap year.");
} else {
    console.log(year + " is not a leap year.");
}




